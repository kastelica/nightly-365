# Nightly 365 — YouTube live embed
#
# Set ONE of these. Do not invent a channel id.
# Find a channel id: YouTube → channel page → share → copy channel ID
# (it usually starts with UC…). Or use any live/video URL.

# Preferred for a recurring nightly livestream:
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=

# Or paste a full watch / live / embed URL, or a video id:
# NEXT_PUBLIC_YOUTUBE_LIVE_URL=https://www.youtube.com/watch?v=XXXXXXXXXXX
NEXT_PUBLIC_YOUTUBE_LIVE_URL=
